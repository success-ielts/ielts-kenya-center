# Public/runtime configuration is injected by Cloudflare at deploy time.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose these to browser code.
RESEND_API_KEY=
CLOUDFLARE_API_TOKEN=
# Optional operations-only key for the legacy #ops email test view.
OPS_SETUP_KEY=

# SUPABASE_SECRET_KEY remains a GitHub Actions secret but is intentionally not
# referenced by browser code or this application runtime.
