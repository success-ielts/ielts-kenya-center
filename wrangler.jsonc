{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ielts-kenya-center",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-17",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "ielts-kenyacenter.or.ke",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
